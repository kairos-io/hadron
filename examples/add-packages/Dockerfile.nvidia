# This Dockerfile demonstrates how to build and add the NVIDIA kernel modules to a Hadron image.
# Its very important that you use the toolchain image at the same version as the Hadron image you want to extend
# nvidia modules use the base kernel build to build the modules (Kbuild) so it needs to match the exact version kernel you
# are going to be run, otherwise it will mismatch and not load the modules during runtime

# Build type is the type of layer we want to build
# As nvidia uses the Kbuild system to build, it generates a given set of files for the alis,deps and whatnot of the kernel
# If you build it standalone, those files will be generated only witht he nvidia modules on it and will overwrite
# the ones generated by the kernel
# building it on top of a modules install will expand those files with the nvidia modules aliases , deps, etc..
# so its recommended to build it on top of a modules install, but if you want to build it standalone you can do it with the slim option
ARG BUILD_TYPE=full
ARG JOBS

FROM ghcr.io/kairos-io/hadron-toolchain:main AS builder-base
ARG NVIDIA_VERSION=580.126.18
WORKDIR /build
RUN curl -L https://github.com/NVIDIA/open-gpu-kernel-modules/archive/refs/tags/${NVIDIA_VERSION}.tar.gz --output nvidia.tar.gz
RUN tar -xf nvidia.tar.gz && rm nvidia.tar.gz
RUN mv open-gpu-kernel-modules-${NVIDIA_VERSION} nvidia-modules
# link the kernel sources to the expected location under /usr/lib/modules/$(uname -r)/build
RUN mkdir -p /lib/modules/$(cat /usr/src/linux/include/config/kernel.release)
RUN ln -s /usr/src/linux /lib/modules/$(cat /usr/src/linux/include/config/kernel.release)/build

FROM builder-base AS slim-builder
# NO-OP

# This target will first build the kernel modules and then build the nvidia modules so the final modules.{dep,alias,symbols}
# files have the full list of modules and their dependencies, this is important for the nvidia modules to load correctly during runtime,
# otherwise they will fail to load due to missing dependencies
FROM builder-base AS full-builder
WORKDIR /usr/src/linux
# Modules were already build in the toolchain/main image so we only need to install them
RUN if [ ${ARCH} = "aarch64" ]; then \
    export ARCH=arm64; \
    else \
    export ARCH=x86_64;\
    fi;  ZSTD_CLEVEL=19 INSTALL_MOD_PATH="/modules" INSTALL_MOD_STRIP=1 DEPMOD=true make -s -j${JOBS} modules_install

FROM ${BUILD_TYPE}-builder AS builder
WORKDIR /build/nvidia-modules
ARG CFLAGS="-Os -pipe"
ARG LDFLAGS="--gc-sections --as-needed"
RUN ARCH=${BUILD_ARCH} KERNEL_UNAME="$(cat /usr/src/linux/include/config/kernel.release)" make -s -j$(nproc) modules
RUN ARCH=${BUILD_ARCH} KERNEL_UNAME="$(cat /usr/src/linux/include/config/kernel.release)" ZSTD_CLEVEL=19 INSTALL_MOD_PATH="/output" INSTALL_MOD_STRIP=1 DEPMOD=true make -s -j$(nproc) modules_install

# This target will copy the built git binaries to a minimal image.
# We can then use this as a layer on top of Hadron to extend it like
# FROM ghcr.io/kairos-io/hadron:VERSION
# COPY --from=OUR_IMAGE_NAME:TAG / /
# Or create a sysextension witht he help of Auroraboot (https://github.com/kairos-io/auroraboot)
FROM scratch AS default
COPY --from=builder /output/ /

## This one instead will pick the existing hadron image as base and add git on top of it.
FROM ghcr.io/kairos-io/hadron:main AS hadron-extension
COPY --from=builder /output/lib/modules/ /usr/lib/modules/
